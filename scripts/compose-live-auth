#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
target="$repo_root/.env"
if [ ! -f "$target" ]; then
    echo "Run ./scripts/compose-init first" >&2
    exit 1
fi

codex_auth=${DARK_FACTORY_LIVE_CODEX_AUTH_JSON:-}
if [ -z "$codex_auth" ]; then
    codex_auth_path=${CODEX_HOME:-"$HOME/.codex"}/auth.json
    if [ ! -f "$codex_auth_path" ]; then
        echo "Codex ChatGPT login not found; run 'codex login' on the host first" >&2
        exit 1
    fi
    codex_auth=$(python -c '
import json, sys
data = json.load(open(sys.argv[1], encoding="utf-8"))
tokens = data.get("tokens", {})
if (data.get("auth_mode") != "chatgpt" or data.get("OPENAI_API_KEY") or
        not all(tokens.get(key) for key in ("access_token", "refresh_token", "id_token"))):
    raise SystemExit("Codex login is not a complete ChatGPT subscription login")
print(json.dumps(data, separators=(",", ":")))
' "$codex_auth_path")
else
    codex_auth=$(CODEX_AUTH_INPUT="$codex_auth" python -c '
import json, os
data = json.loads(os.environ["CODEX_AUTH_INPUT"])
tokens = data.get("tokens", {})
if (data.get("auth_mode") != "chatgpt" or data.get("OPENAI_API_KEY") or
        not all(tokens.get(key) for key in ("access_token", "refresh_token", "id_token"))):
    raise SystemExit("Codex login is not a complete ChatGPT subscription login")
print(json.dumps(data, separators=(",", ":")))
')
fi

github_token=${DARK_FACTORY_GITHUB_TOKEN:-}
if [ -z "$github_token" ] && command -v gh >/dev/null 2>&1; then
    github_token=$(gh auth token 2>/dev/null || true)
fi

upsert() {
    key=$1
    value=$2
    temporary="$target.tmp.$$"
    found=0
    while IFS= read -r line; do
        case "$line" in
            "$key="*)
                printf '%s=%s\n' "$key" "$value"
                found=1
                ;;
            *) printf '%s\n' "$line" ;;
        esac
    done < "$target" > "$temporary"
    if [ "$found" -eq 0 ]; then
        printf '%s=%s\n' "$key" "$value" >> "$temporary"
    fi
    mv "$temporary" "$target"
}

umask 077
upsert DARK_FACTORY_LIVE_CODEX_AUTH_JSON "$codex_auth"
if [ -n "$github_token" ]; then
    upsert DARK_FACTORY_GITHUB_TOKEN "$github_token"
fi
chmod 600 "$target"
echo "Stored live container credentials in the gitignored .env (mode 0600)."
