#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
target="$repo_root/.env"
if [ ! -f "$target" ]; then
    echo "Run ./scripts/compose-init first" >&2
    exit 1
fi

together_key=${DARK_FACTORY_LIVE_TOGETHER_KEY:-${TOGETHER_API_KEY:-}}
if [ -z "$together_key" ]; then
    printf 'Together API key (input hidden): ' >&2
    restore_tty() {
        stty echo 2>/dev/null || true
    }
    trap restore_tty EXIT HUP INT TERM
    stty -echo
    IFS= read -r together_key
    stty echo
    trap - EXIT HUP INT TERM
    printf '\n' >&2
fi
if [ "${#together_key}" -lt 20 ]; then
    echo "Together API key is missing or unexpectedly short" >&2
    exit 1
fi

github_token=${DARK_FACTORY_GITHUB_TOKEN:-}
if [ -z "$github_token" ] && command -v gh >/dev/null 2>&1; then
    github_token=$(gh auth token 2>/dev/null || true)
fi

upsert() {
    key=$1
    value=$2
    temporary="$target.tmp.$$"
    found=0
    while IFS= read -r line; do
        case "$line" in
            "$key="*)
                printf '%s=%s\n' "$key" "$value"
                found=1
                ;;
            *) printf '%s\n' "$line" ;;
        esac
    done < "$target" > "$temporary"
    if [ "$found" -eq 0 ]; then
        printf '%s=%s\n' "$key" "$value" >> "$temporary"
    fi
    mv "$temporary" "$target"
}

umask 077
upsert DARK_FACTORY_LIVE_TOGETHER_KEY "$together_key"
if [ -n "$github_token" ]; then
    upsert DARK_FACTORY_GITHUB_TOKEN "$github_token"
fi
chmod 600 "$target"
echo "Stored live container credentials in the gitignored .env (mode 0600)."
