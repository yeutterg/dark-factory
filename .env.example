# `./scripts/compose-init` creates `.env` with private random values.
COMPOSE_PROJECT_NAME=replace-with-a-unique-project-name
DARK_FACTORY_IMAGE=dark-factory:local
COMPOSE_OPERATOR_TOKEN=replace-with-at-least-32-random-characters
COMPOSE_LEGACY_WORKER_TOKEN=replace-with-at-least-32-random-characters
COMPOSE_WORKER_TOKEN=replace-with-at-least-32-random-characters
DARK_FACTORY_LIVE_TOGETHER_KEY=
DARK_FACTORY_GITHUB_TOKEN=
# Set locally by scripts/compose-live-init; omit for the simulation-only fixture.
# COMPOSE_FILE=compose.yaml:compose.live.yaml
