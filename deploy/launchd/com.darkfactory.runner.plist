<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.darkfactory.runner</string>
  <key>ProgramArguments</key><array>
    <string>/usr/local/bin/dark-factory</string><string>runner</string>
    <string>--profile</string><string>/usr/local/etc/dark-factory/runner.toml</string>
  </array>
  <key>RunAtLoad</key><true/><key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/usr/local/var/log/dark-factory-runner.log</string>
  <key>StandardErrorPath</key><string>/usr/local/var/log/dark-factory-runner.log</string>
</dict></plist>
