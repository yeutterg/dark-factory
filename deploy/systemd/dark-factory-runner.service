[Unit]
Description=Dark Factory outbound runner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dark-factory-runner
Group=dark-factory-runner
EnvironmentFile=-/etc/dark-factory/runner.env
ExecStart=/usr/local/bin/dark-factory runner --profile /etc/dark-factory/runner.toml
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/dark-factory-runner

[Install]
WantedBy=multi-user.target
