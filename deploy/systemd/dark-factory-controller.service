[Unit]
Description=Dark Factory controller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dark-factory
Group=dark-factory
EnvironmentFile=-/etc/dark-factory/controller.env
ExecStart=/usr/local/bin/dark-factory --config /etc/dark-factory/factory.toml serve
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/dark-factory

[Install]
WantedBy=multi-user.target
